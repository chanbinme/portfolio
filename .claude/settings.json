{
  "extraKnownMarketplaces": {
    "im-not-ai": {
      "source": {
        "source": "github",
        "repo": "epoko77-ai/im-not-ai",
        "ref": "v2.3.2"
      }
    }
  },
  "enabledPlugins": {
    "humanize-korean@im-not-ai": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck.sh",
            "timeout": 60,
            "statusMessage": "타입 검사 중"
          }
        ]
      }
    ]
  }
}
